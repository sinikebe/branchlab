{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siniverse-branchlab-site",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "routes": [
    {
      "pattern": "branchlab.siniverse.cc",
      "custom_domain": true,
    },
    {
      "pattern": "dev.branchlab.siniverse.cc",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
