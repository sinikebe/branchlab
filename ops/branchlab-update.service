[Unit]
Description=Validate and update BranchLab from origin/dev
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/root
Environment=BRANCHLAB_REPOSITORY=git@github-branchlab-deploy:sinikebe/branchlab.git
ExecStart=/bin/bash /usr/local/lib/branchlab/update-dev.sh
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
